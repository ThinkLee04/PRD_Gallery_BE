# ---------------------------------------------------------------
# Photo Vault API — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# The auth module is active: Google OAuth + session keys are
# required at boot (fail fast). R2 keys remain reserved for the
# uploads module and are validated there when it lands.
# ---------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Managed/external PostgreSQL (TLS enabled in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Browser origin allowed to call the API (CORS, no wildcard).
CORS_ORIGIN=http://localhost:5173

# ---- Auth module (Google OAuth 2.0 / OIDC, sessions) -----------
# Browser base URL; OAuth callbacks redirect here after login.
APP_BASE_URL=http://localhost:5173

# Google Cloud OAuth client credentials (type "Web application").
# GOOGLE_REDIRECT_URI must be registered as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# High-entropy server secret (>= 32 chars) used to encrypt the
# short-lived OAuth login-state cookie. Never commit or log it.
SESSION_SECRET=

# Session cookie lifetime in days.
SESSION_TTL_DAYS=30

# In-memory per-IP rate limit for the OAuth endpoints.
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Per-approved-user upload initialization limit. Sized for large browser batches.
UPLOAD_RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated Google emails that bootstrap as approved vault owners.
APP_ADMIN_EMAILS=admin@example.com
SINGLE_VAULT_NAME=Photo Vault

# ---- Private Cloudflare R2 -------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_UPLOAD_URL_TTL_SECONDS=1800
R2_DOWNLOAD_URL_TTL_SECONDS=600
MAX_IMAGE_UPLOAD_BYTES=104857600
MAX_VIDEO_UPLOAD_BYTES=209715200
