# ---------------------------------------------------------------
# Photo Vault API — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# The server only consumes NODE_ENV, HOST, PORT and DATABASE_URL
# in this base build; the remaining keys are reserved for the
# auth (Google OAuth) and R2 modules and are validated there.
# ---------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Managed/external PostgreSQL (TLS enabled in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Browser origin allowed to call the API (CORS, no wildcard).
CORS_ORIGIN=http://localhost:5173

# ---- Reserved for the auth module (not validated yet) ----------
# APP_BASE_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# SESSION_SECRET=
# SESSION_TTL_DAYS=30

# ---- Reserved for the uploads/R2 module (not validated yet) ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_UPLOAD_URL_TTL_SECONDS=900
# R2_DOWNLOAD_URL_TTL_SECONDS=600
# MAX_UPLOAD_BYTES=
