# Photo Vault API — server env file template.
#
# 1) Copy to the VPS as /opt/photo-vault/photo-vault.env and fill with real values.
# 2) chmod 600 (owner root if the service runs as root; else the service user).
# 3) NEVER commit this file — keep only this template in git.
#
# This file is loaded by BOTH systemd (EnvironmentFile=...) and the deploy
# script (bash `source`). Rules that keep both parsers happy:
#   - no `export` lines, no spaces around `=`
#   - wrap values containing spaces or shell specials in double quotes
#   - a `#` starts a comment; avoid it inside values (quote them if needed)

# --- Runtime ------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- Database (managed/external Postgres, TLS in production) ------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# --- CORS: the exact browser origin that calls the API (the Vercel app) ---
# Do not use "*" with credentials.
CORS_ORIGIN=https://app.example.com

# --- Auth (Google OAuth) — uncomment when the auth module is deployed ---
# APP_BASE_URL=https://app.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
# SESSION_SECRET=                    # high-entropy, >= 32 chars
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Uploads / R2 — uncomment when the uploads module is deployed --------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_UPLOAD_URL_TTL_SECONDS=900
# R2_DOWNLOAD_URL_TTL_SECONDS=600
# MAX_UPLOAD_BYTES=
